@model Practical_7.Models.FeedbackModel

@using (Html.BeginForm("SubmitFeedback", "Feedback", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-group mb-3">
        @Html.LabelFor(m => m.StudentName, "Student Name")
        @Html.TextBoxFor(m => m.StudentName, new { @class = "form-control", placeholder = "Enter your name" })
        @Html.ValidationMessageFor(m => m.StudentName, "", new { @class = "text-danger" })
    </div>

    <div class="form-group mb-3">
        @Html.LabelFor(m => m.Email, "Email Address")
        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "name@example.com" })
        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
    </div>

    <div class="form-group mb-3">
        @Html.LabelFor(m => m.CourseName, "Course / Module")
        @Html.DropDownListFor(
            m => m.CourseName, 
            new SelectList(new[] { "ASP.NET MVC", "HTML Helpers", "Partial Views & Validation" }), 
            "Select Course", 
            new { @class = "form-control" }
        )
        @Html.ValidationMessageFor(m => m.CourseName, "", new { @class = "text-danger" })
    </div>

    <div class="form-group mb-3">
        @Html.LabelFor(m => m.Rating, "Rating (1-5)")
        @Html.TextBoxFor(m => m.Rating, new { @class = "form-control", type = "number", min = "1", max = "5" })
        @Html.ValidationMessageFor(m => m.Rating, "", new { @class = "text-danger" })
    </div>

    <div class="form-group mb-3">
        @Html.LabelFor(m => m.Comments, "Comments")
        @Html.TextAreaFor(m => m.Comments, 4, 40, new { @class = "form-control", placeholder = "Write your feedback here..." })
        @Html.ValidationMessageFor(m => m.Comments, "", new { @class = "text-danger" })
    </div>

    <button type="submit" class="btn btn-primary">Submit Feedback</button>
}
